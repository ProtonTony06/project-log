# .env.example — copiar a .env y rellenar. .env NUNCA se sube a git.
POSTGRES_DB=project_log
POSTGRES_USER=project_log_user
# Generar: openssl rand -base64 24
POSTGRES_PASSWORD=<generar-password-fuerte>
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/project_log
# Generar: openssl rand -base64 48  (≥32 bytes aleatorios; cambiarlo invalida los JWT)
JWT_SECRET=<cadena-larga-y-aleatoria-jamás-en-código>
JWT_TTL_HOURS=8
ADMIN_INITIAL_USERNAME=admin
# Sin default: obligatoria en el primer arranque (seed del admin, C2)
ADMIN_INITIAL_PASSWORD=<solo-al-desplegar-la-primera-vez>
FRONTEND_ORIGIN=http://<ip-vm>:8080  # solo para desarrollo/CORS
INGEST_MAX_REQUEST_BYTES=1MiB
INGEST_MAX_BATCH_SIZE=200
WS_HEARTBEAT_SECONDS=30
SPRING_PROFILES_ACTIVE=prod
LOGGING_LEVEL=INFO
TZ=UTC
# FRONTEND_BIND=0.0.0.0